FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=
JWT_SECRET_KEY=
AUTO_CREATE_DATABASE=false
ENABLE_API_DOCS=false
API_DOCS_REQUIRE_MASTER_ADMIN=true

# PostgreSQL remains the system of record for permissions and knowledge metadata.
DATABASE_URL=postgresql+psycopg://maintenance:${POSTGRES_PASSWORD}@db:5432/maintenance
POSTGRES_PASSWORD=

# MongoDB Atlas: same cluster as other apps; use a dedicated database (not ai_email).
MONGODB_URI=
MONGODB_DB_NAME=maintenance_ai
MONGODB_TIMEOUT_MS=3000

# MongoDB Atlas Vector Search stores retrieval candidates only.
RAG_VECTOR_STORE=mongodb_atlas
MONGODB_ATLAS_URI=
MONGODB_ATLAS_DATABASE=maintenance_ai
MONGODB_ATLAS_VECTOR_COLLECTION=knowledge_vectors
MONGODB_ATLAS_VECTOR_INDEX=knowledge_vector_index
MONGODB_ATLAS_TIMEOUT_MS=3000

# OpenAI embeddings must match the Atlas index dimensions (1536 for text-embedding-3-small).
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
RAG_STRICT_QUALITY_GATE=true
AI_GENERATE_WITHOUT_EVIDENCE=false
AI_CHAT_RATE_LIMIT_PER_MINUTE=30

# Persistent storage
UPLOAD_FOLDER=/app/data/uploads
DOCUMENTS_FOLDER=/app/documents
MANUALS_FOLDER=/app/manuals
KNOWLEDGE_FOLDER=/app/knowledge
BACKUP_FOLDER=/app/backups
LOG_DIR=/app/logs

# Worker
WORKER_RAG_REINDEX_ENABLED=true
WORKER_POLL_SECONDS=60

# Mail stays disabled until SMTP is verified.
MAIL_ENABLED=false
MAIL_DRY_RUN=true

# Langfuse (optional observability + evaluation scores)
# LANGFUSE_ENABLED=true
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_EVAL_ENABLED=true
# LANGFUSE_EVAL_CAPTURE_IO=false

# Smoke check before release:
# python scripts/rag_atlas_smoke.py
