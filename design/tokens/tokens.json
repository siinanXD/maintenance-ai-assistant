  },
  "semantic": {
    "color": {
      "action": {
        "default": {
          "$type": "color",
          "$value": "{color.blue.600}"
        },
        "on": {
          "$type": "color",
          "$value": "{color.white}"
        }
      },
      "support": {
        "default": {
          "$type": "color",
          "$value": "{color.teal.700}"
        },
        "on": {
          "$type": "color",
          "$value": "{color.white}"
        }
      },
      "highlight": {
        "default": {
          "$type": "color",
          "$value": "{color.cyan.500}"
        },
        "on": {
          "$type": "color",
          "$value": "{color.cyan.950}"
        }
      },
      "contrast": {
        "default": {
          "$type": "color",
          "$value": "{color.gray.900}"
        },
        "on": {
          "$type": "color",
          "$value": "{color.slate.50}"
        }
      },
      "surface": {
        "page": {
          "$type": "color",
          "$value": "{color.white}"
        },
        "raised": {
          "$type": "color",
          "$value": "{color.slate.50}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.slate.200}"
        }
      },
      "text": {
        "primary": {
          "$type": "color",
          "$value": "{color.slate.900}"
        }
      },
      "status": {
        "info": {
          "$type": "color",
          "$value": "{color.sky.600}"
        },
        "info-on": {
          "$type": "color",
          "$value": "{color.white}"
        },
        "ok": {
          "$type": "color",
          "$value": "{color.green.600}"
        },
        "ok-on": {
          "$type": "color",
          "$value": "{color.white}"
        },
        "warn": {
          "$type": "color",
          "$value": "{color.yellow.400}"
        },
        "warn-on": {
          "$type": "color",
          "$value": "{color.yellow.950}"
        },
        "critical": {
          "$type": "color",
          "$value": "{color.red.600}"
        },
        "critical-on": {
          "$type": "color",
          "$value": "{color.white}"
        }
      }
    },
    "sidebar": {
      "$description": "Wird von der Tailwind-Klasse in base.html gelesen: lg:grid-cols-[var(--sidebar-width)_minmax(0,1fr)].",
      "width": {
        "$type": "dimension",
        "$value": "264px"
      },
      "width-collapsed": {
        "$type": "dimension",
        "$value": "64px"
      }
    },
    "topbar": {
      "height": {
        "$type": "dimension",
        "$value": "56px"
      }
    },
    "shell": {
      "row-height": {
        "$type": "dimension",
        "$value": "36px"
      }
    },
    "breakpoint": {
      "$description": "Die einzigen vier erlaubten Breakpoints. In @media sind Custom Properties nicht verwendbar, die Variablen dienen der Nachschlagbarkeit; Tailwind erhaelt dieselben Werte als screens.",
      "sm": {
        "$type": "dimension",
        "$value": "640px"
      },
      "md": {
        "$type": "dimension",
        "$value": "768px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "1024px"
      },
      "xl": {
        "$type": "dimension",
        "$value": "1440px"
      }
    },
    "space": {
      "$description": "Basis 4px. Deckungsgleich mit Tailwinds Standardskala, daher ohne Tailwind-Override.",
      "1": {
        "$type": "dimension",
        "$value": "4px"
      },
      "2": {
        "$type": "dimension",
        "$value": "8px"
      },
      "3": {
        "$type": "dimension",
        "$value": "12px"
      },
      "4": {
        "$type": "dimension",
        "$value": "16px"
      },
      "6": {
        "$type": "dimension",
        "$value": "24px"
      },
      "8": {
        "$type": "dimension",
        "$value": "32px"
      },
      "12": {
        "$type": "dimension",
        "$value": "48px"
      }
    },
    "radius": {
      "$description": "Zielskala nach Rolle. Noch nicht auf die 295 Freihand-Deklarationen angewendet, das ist Schritt 4 bis 6.",
      "sm": {
        "$type": "dimension",
        "$value": "2px"
      },
      "md": {
        "$type": "dimension",
        "$value": "3px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "6px"
      }
    },
    "elevation": {
      "$description": "Zielskala. elevation-0 ist der Standard: Trennung erfolgt ueber Linien, nicht ueber Schatten.",
      "0": {
        "$type": "shadow",
        "$value": "none"
      },
      "1": {
        "$type": "shadow",
        "$value": "0 1px 2px rgba(15, 23, 42, 0.08)"
      },
      "2": {
        "$type": "shadow",
        "$value": "0 8px 24px rgba(15, 23, 42, 0.12)"
      }
    }
  },
  "$themes": [],
  "$metadata": {
    "tokenSetOrder": [
      "core",
      "semantic"
    ]
  }
}
