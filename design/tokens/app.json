{
  "sidebar": {
    "width": {
      "$type": "dimension",
      "$value": "{size.sidebar-expanded}"
    },
    "width-collapsed": {
      "$type": "dimension",
      "$value": "{size.sidebar-collapsed}"
    }
  },
  "topbar": {
    "height": {
      "$type": "dimension",
      "$value": "{size.topbar-height}"
    }
  },
  "shell": {
