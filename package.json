{
  "name": "maintanaceaisisst",
  "version": "1.0.0",
  "description": "Modulare Flask-Anwendung fuer Wartung, Produktion und Instandhaltung. Die App bietet JWT-Login, rollenbasierte Navigation, Aufgaben, Fehlerkataloge, Mitarbeiterdaten, Maschinen, Lager und optionale KI-Funktionen.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build:tokens": "node ./scripts/build_tokens.mjs",
    "build:css": "npm run build:tokens && node ./scripts/build_css.mjs",
    "build:react": "npm --prefix frontend run build",
    "check:react": "npm --prefix frontend run typecheck",
    "build:frontend": "npm run build:css && npm run build:react",
    "lint": ".\\.venv\\Scripts\\python.exe -m ruff check app tests",
    "test": "npm run lint && .\\.venv\\Scripts\\python.exe -m pytest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siinanXD/MaintanaceAIsisst.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/siinanXD/MaintanaceAIsisst/issues"
  },
  "homepage": "https://github.com/siinanXD/MaintanaceAIsisst#readme",
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.12",
    "style-dictionary": "^4.4.0",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "daisyui": "^5.5.19"
  }
}
